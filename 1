<h2>Linear Search Program (C)</h2>

<pre>

#include<stdio.h>

int linear_search(int arr[], int n, int x)
{
    int i;
    for(i=0;i<n;i++)
    {
        if(arr[i]==x)
        return i;
    }
    return -1;
}

int main()
{
    int arr[5]={5,2,9,1,7};
    int x=7;
    int result;

    result = linear_search(arr,5,x);

    if(result==-1)
        printf("Not Found");
    else
        printf("Element Found at index %d",result);

    return 0;
}

