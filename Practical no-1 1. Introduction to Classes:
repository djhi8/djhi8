 a) Create a simple class with data members and member functions.

Code:-
#include <iostream.h>
#include <string.h>
#include <conio.h>

class student
{
    char name[20];
    int age;

public:
    void setdata()
    {
        strcpy(name, "alice");
        age = 20;
    }

    void displaydata()
    {
        cout << "Name: " << name << endl;
        cout << "Age: " << age << endl;
    }
};

void main()
{
    clrscr();
    student s;
    s.setdata();
    s.displaydata();
    getch();
}

b) Demonstrate the use of class instances to access data and invoke member functions.

Code:-
#include <iostream.h>
#include <conio.h>

class car
{
    int speed;

public:
    void setspeed()
    {
        speed = 60;
    }

    void showspeed()
    {
        cout << "Car speed: " << speed << " km/h" << endl;
    }
};

void main()
{
    clrscr();

    car c1;
    c1.setspeed();
    c1.showspeed();

